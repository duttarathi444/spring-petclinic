pipeline{
    agent any
    tools{
        maven 'MAVEN-3.9.16'
    }
    parameters{
        string(name: 'GOALS', defaultValue: 'clean package', description: 'Maven Goals')
    }
    stages{
        stage('SCM'){
            steps{
                git url: 'https://github.com/spring-projects/spring-petclinic.git',
                    branch: 'main'
            }
        }
        stage('BUILD'){
            steps{
                sh 'mvn --version'
                sh "mvn ${params.GOALS}"
            }
        }
    }
}